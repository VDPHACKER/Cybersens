# Certificat Let's Encrypt obtenu et renouvelé automatiquement pour {$DOMAIN}.
{$DOMAIN} {
	encode gzip zstd

	# Flux temps réel des salles de quiz (Server-Sent Events) : pas de mise en tampon
	@sse path /api/rooms/stream
	handle @sse {
		reverse_proxy app:8080 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy app:8080
	}
}
