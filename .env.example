# Copier ce fichier en .env (Docker) ou .env.local (npm run dev / npm start), puis renseigner les valeurs.
# Ne jamais versionner le fichier réel.

# Clé API Gemini (assistant IA). Reste côté serveur, jamais envoyée au navigateur.
GEMINI_API_KEY=

# Secret de signature des certificats (64 caractères hexadécimaux recommandés : openssl rand -hex 32).
# Optionnel : sinon généré automatiquement et conservé en base. Ne plus le changer une fois des certificats émis.
CERT_SECRET=

# Port d'écoute du serveur de production
PORT=8080

# 1 derrière un reverse-proxy HTTPS : active HSTS, cookies « Secure » et l'IP réelle du client
TRUST_PROXY=0

# Base de données PostgreSQL (Neon, Supabase…) : chaîne de connexion complète. Recommandé en production.
# Sans DATABASE_URL, une base PostgreSQL embarquée (PGlite) est utilisée dans DB_PATH : développement uniquement.
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require
# DB_PATH=data/pglite

# 0 pour désactiver le journal d'accès JSON
# ACCESS_LOG=1

# E-mails des administrateurs (séparés par des virgules) autorisés à utiliser le Centre DevOps.
# Vide = routes d'administration désactivées.
# ADMIN_EMAILS=admin@exemple.com

# Dossier des sauvegardes de la base (par défaut : backups/)
# BACKUP_DIR=/chemin/vers/backups

# Modèles IA de secours si le modèle principal est surchargé (séparés par des virgules)
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
# Délai maximal (ms) avant le premier octet en streaming, au-delà on passe au modèle suivant (défaut 5000)
# GEMINI_HEADER_TIMEOUT_MS=5000

# Connexion avec Google (optionnel). ID client OAuth « Application Web » créé dans Google Cloud Console
# (APIs et services > Identifiants). Ajouter l'URL du site dans « Origines JavaScript autorisées ».
# Vide = le bouton Google est masqué.
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Mot de passe oublié par e-mail (optionnel). Sans configuration, l'écran renvoie vers l'administrateur.
# Il faut un fournisseur (Brevo OU Resend), MAIL_FROM et PUBLIC_URL.
#  - Brevo (gratuit, 300 e-mails/jour, sans nom de domaine : l'adresse expéditrice est validée par e-mail) : https://brevo.com
#  - Resend (exige un nom de domaine vérifié) : https://resend.com
# Les ports SMTP sont bloqués sur Render gratuit : seules ces API HTTPS fonctionnent.
# BREVO_API_KEY=xkeysib-xxxxxxxx
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=CyberSens <votre-adresse-validee@gmail.com>
# PUBLIC_URL=https://votre-site.onrender.com

# E-mail de contact affiché dans les conditions d'utilisation (droits RGPD). Vide = renvoi vers l'administrateur du site.
# CONTACT_EMAIL=contact@votre-domaine.com
